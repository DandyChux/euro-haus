{
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://your-go-api.herokuapp.com/api/:path*"
		},
		{
			"source": "/webhook",
			"destination": "https://your-go-api.herokuapp.com/webhook"
		},
		{
			"source": "/(.*)",
			"destination": "/"
		}
	],
	"headers": [
		{
			"source": "/api/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		}
	]
}
