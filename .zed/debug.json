// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		"label": "Launch Chromee (TypeScript)",
		"adapter": "JavaScript",
		"type": "pwa-chrome",
		"request": "launch",
		"url": "http://localhost:3001",
		"program": "$ZED_FILE",
		"webRoot": "${ZED_WORKTREE_ROOT}",
		"sourceMaps": true,
		"build": {
			"command": "npx",
			"args": ["tsc"],
		},
	},
	{
		"label": "Launch Go (Delve)",
		"adapter": "Delve",
		"program": "${ZED_WORKTREE_ROOT}/api/main.go",
		"request": "launch",
		"mode": "debug",
		"cwd": "${ZED_WORKTREE_ROOT}",
	},
	{
		"label": "Launch Go w/ Air (HMR)",
		"adapter": "Delve",
		"program": "${ZED_WORKTREE_ROOT}/cmd/server/main.go",
		"request": "launch",
		"mode": "debug",
		"cwd": "${ZED_WORKTREE_ROOT}",
		"build": {
			"command": "air",
			"args": ["-c", "air.toml"],
		},
	},
]
